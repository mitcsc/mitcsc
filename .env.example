# Existing public links spreadsheet
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_SHEET_ID=

# Optional overrides. CSC settings sheet and signing key work with existing Google credentials.
# Settings spreadsheet is separate from public links.
VOTING_SETTINGS_SHEET_ID=1CRZtuOwF7iouzHrj_n5TCofcNtCtzfBQvsa8Ez9wLXQ
# Optional: at least 32 random characters. Never use the session password here.
VOTING_COOKIE_SECRET=

# Membership signup (/membership) and exec dashboard (/dashboard)
# Upstash Redis, shared with voting. Vercel's Upstash integration sets KV_REST_API_URL and KV_REST_API_TOKEN instead.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Google OAuth client (type "Web application"). Redirect URI: https://csc.mit.edu/api/auth/google/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# The club Google account that owns the Drive folders and receives Venmo emails.
CLUB_GOOGLE_EMAIL=mitcsc@gmail.com
# At least 32 random characters. Signs member cookies, exec sessions, and Wallet card QR codes.
MEMBERSHIP_SECRET=
# Optional: Apple and Google Wallet cards from walletwallet.dev. Set WALLETWALLET_PLAN=pro after upgrading.
WALLETWALLET_API_KEY=
WALLETWALLET_PLAN=
# Vercel sends this to the daily cron jobs.
CRON_SECRET=
# Local development only: sign in to /dashboard as this email without Google.
DASHBOARD_DEV_EMAIL=
